#!/bin/bash
# dump-project — DB dump + config backup for a single project.
# Usage: dump-project <config-name>
#
# Sources /etc/cron/projects/<config-name> (no extension), which must define:
#   PROJECT          Project directory name under /var/www (backups go to /var/backup/<PROJECT>)
#   DB_NAME          Database name or space-separated list (empty = config files only)
#   DB_ENGINE        mysql (default) or pgsql
#   RETENTION_DAYS   Delete dumps older than this
#   CONFIG_PATHS     Space-separated paths relative to /var/www/<PROJECT>
#
# Expects MYSQL_ROOT_PASSWORD (and POSTGRES_USER/POSTGRES_PASSWORD for pgsql) in the environment.

set -euo pipefail

CONFIG="${1:?Usage: $0 <config-name>}"
ENV_FILE="/etc/cron/projects/${CONFIG}"

if [ ! -f "$ENV_FILE" ]; then
    echo "[dump-project] ERROR: ${ENV_FILE} not found" >&2
    exit 1
fi

source "$ENV_FILE"

: "${PROJECT:?PROJECT is not set in ${ENV_FILE}}"

DATA_DIR="/var/www/${PROJECT}"
BACKUP_DIR="/var/backup/${PROJECT}"

if [ ! -d "$DATA_DIR" ]; then
    echo "[dump-project] ERROR: ${DATA_DIR} not found" >&2
    exit 1
fi

DATE=$(date +%Y%m%d_%H%M)
mkdir -p "$BACKUP_DIR"

# DB dump — one file per database; skipped when DB_NAME is empty
if [ -n "${DB_NAME:-}" ]; then
    echo "[dump-project] db: ${DB_NAME} → ${BACKUP_DIR}"
    # shellcheck disable=SC2086  # intentional word splitting on the name list
    for db in ${DB_NAME}; do
        if [ "${DB_ENGINE:-mysql}" = "pgsql" ]; then
            PGPASSWORD="${POSTGRES_PASSWORD}" pg_dump -h pg -U "${POSTGRES_USER:-postgres}" \
                --clean --if-exists --no-owner --no-privileges \
                "$db" | gzip > "${BACKUP_DIR}/db_${db}_${DATE}.sql.gz"
        else
            mariadb-dump -h db -u root -p"${MYSQL_ROOT_PASSWORD}" \
                --ssl-verify-server-cert=0 \
                --quote-names --single-transaction --no-tablespaces --extended-insert --add-drop-table \
                "$db" | gzip > "${BACKUP_DIR}/db_${db}_${DATE}.sql.gz"
        fi
        echo "[dump-project] ${db} done ($(du -h "${BACKUP_DIR}/db_${db}_${DATE}.sql.gz" | cut -f1))"
    done
else
    echo "[dump-project] DB_NAME empty — config files only"
fi

# Config dump
# shellcheck disable=SC2086
tar czf "${BACKUP_DIR}/config_${DATE}.tar.gz" -C "$DATA_DIR" $CONFIG_PATHS

# Rotate
find "$BACKUP_DIR" -mtime "+${RETENTION_DAYS}" -delete

echo "[dump-project] ${PROJECT} done"
