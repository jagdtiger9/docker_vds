#!/bin/bash
# dump-project — DB dump + config backup for a single project.
# Usage: dump-project <project-root>
#
# Sources <project-root>/dump.env which must define:
#   DB_NAME          Database name
#   RETENTION_DAYS   Delete dumps older than this
#   CONFIG_PATHS     Space-separated paths relative to project root
#
# Backups are stored in /var/backup/<project-name>/.
# Expects MYSQL_ROOT_PASSWORD in the environment.

set -euo pipefail

PROJECT="${1:?Usage: $0 <project-root>}"
ENV_FILE="${PROJECT%/}/dump.env"

source "$ENV_FILE"

NAME=$(basename "$PROJECT")
BACKUP_DIR="/var/backup/${NAME}"
DATE=$(date +%Y%m%d_%H%M)
mkdir -p "$BACKUP_DIR"

echo "[dump-project] ${DB_NAME} → ${BACKUP_DIR}"

# DB dump
mariadb-dump -h db -u root -p"${MYSQL_ROOT_PASSWORD}" \
    --ssl-verify-server-cert=0 \
    --quote-names --single-transaction --no-tablespaces --extended-insert --add-drop-table \
    "$DB_NAME" | gzip > "${BACKUP_DIR}/db_${DATE}.sql.gz"

# Config dump
# shellcheck disable=SC2086
tar czf "${BACKUP_DIR}/config_${DATE}.tar.gz" -C "$PROJECT" $CONFIG_PATHS

# Rotate
find "$BACKUP_DIR" -mtime "+${RETENTION_DAYS}" -delete

echo "[dump-project] ${DB_NAME} done ($(du -h "${BACKUP_DIR}/db_${DATE}.sql.gz" | cut -f1))"
